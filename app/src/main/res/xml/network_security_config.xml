<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local LAN HTTP/WebSocket access for ESP-Miner / AxeOS devices on private networks -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
